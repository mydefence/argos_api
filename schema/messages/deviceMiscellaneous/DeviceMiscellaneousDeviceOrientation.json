{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DeviceMiscellaneousDeviceOrientation",
    "type": "object",
    "description": "Only used with MD RF sensors to handle devices mounted upside-down.",
    "properties": {
        "deviceId": {
            "type": "string",
            "description": "The device id"
        },
        "deviceMiscellaneousType": {
            "allOf": [
                {
                    "$ref": "./DeviceMiscellaneousType.json#"
                },
                {
                    "const": "deviceOrientation"
                }
            ]
        },
        "deviceMiscellaneousData": {
            "type": "object",
            "properties": {
                "deviceOrientation": {
                    "type": "number",
                    "description": "Orientation of device in degrees. Currently only 0 and 180 supported.",
                    "enum": [0, 180]
                }
            },
            "additionalProperties": false,
            "required": ["deviceOrientation"]
        }
    },
    "additionalProperties": false,
    "required": ["deviceId", "deviceMiscellaneousType", "deviceMiscellaneousData"]
}
