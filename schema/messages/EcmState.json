{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "EcmState",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "deviceId": {
            "type": "string"
        },
        "deviceParentId": {
            "type": ["string", "null"],
            "title": "Device identification"
        },
        "activeFrequencyBands": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "deviceDetails": {
            "type": "object",
            "description": "DEPRECATED. Is never included"
        },
        "timestamp": {
            "type": "string",
            "description": "DEPRECATED. Is never included"
        },
        "timeout": {
            "type": "integer",
            "description": "Timeout (seconds) of auto jamming. Set when deviceId ='auto'"
        }
    },
    "required": ["deviceId", "activeFrequencyBands"]
}
