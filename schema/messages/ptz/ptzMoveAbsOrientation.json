{
    "type": "object",
    "properties": {
        "deviceId": {
            "type": "string",
            "title": "Device identification",
            "description": "Device ID of a PTZ device"
        },
        "subDeviceId": {
            "type": "number",
            "title": "Sub-device identification",
            "description": "ID of a sub device of the PTZ device."
        },
        "orientation": {
            "type": "object",
            "title": "Target orientation of the PTZ device",
            "description": "PTZ device will move to the specified orientation [deg]",
            "properties": {
                "p": {
                    "description": "Pan orientation [deg].",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "const": "default",
                            "description": "Deprecated. No longer supported; treated as if pan were not present."
                        }
                    ]
                },
                "t": {
                    "description": "Tilt orientation [deg].",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "const": "default",
                            "description": "Deprecated. No longer supported; treated as if tilt were not present."
                        }
                    ]
                },
                "z": {
                    "description": "Zoom position.",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "const": "default",
                            "description": "Deprecated. No longer supported; treated as if zoom were not present."
                        }
                    ]
                },
                "f": {
                    "description": "Focus [pct].",
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "const": "auto-focus",
                            "description": "Triggers one-shot auto-focus, if supported."
                        },
                        {
                            "const": "default",
                            "description": "Deprecated. Use \"auto-focus\" instead. Mapped to \"auto-focus\"."
                        }
                    ]
                },
                "zUnits": {
                    "type": "string",
                    "description": "Unit of zoom e.g. deg FOV or percentage of full range. Supported units are device dependent and both units may not be supported by all devices.",
                    "enum": ["deg", "pct"]
                }
            },
            "additionalProperties": false,
            "minProperties": 1
        },
        "startAcquisition": {
            "type": "boolean",
            "description": "Start searching for threats at the requested orientation after the move is completed."
        }
    },
    "additionalProperties": false,
    "required": ["deviceId", "orientation"]
}
